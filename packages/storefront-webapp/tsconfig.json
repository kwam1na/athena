{
  "compilerOptions": {
    // Enable latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "useDefineForClassFields": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      // Shared DTOs live in the neutral contract package, never in the Athena
      // admin application root. See packages/athena-contracts/README.md.
      "@athena/contracts": ["../athena-contracts/index.ts"],
      "@athena/contracts/*": ["../athena-contracts/*"]
    },
    "types": ["vitest/globals", "vite/client", "@testing-library/jest-dom"]
  }
}
